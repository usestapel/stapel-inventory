{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.stock.out",
  "description": "A stock item's available units reached zero or below. Fires once per transition into out. Key = stock item id.",
  "type": "object",
  "properties": {
    "stock_item_id": {
      "type": "string"
    },
    "purchasable_type": {
      "type": "string",
      "maxLength": 32
    },
    "purchasable_key": {
      "type": "string",
      "maxLength": 255
    },
    "location": {
      "type": "string",
      "maxLength": 32
    },
    "on_hand": {
      "type": "integer"
    },
    "available": {
      "type": "integer"
    },
    "threshold": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "stock_item_id",
    "purchasable_type",
    "purchasable_key",
    "location",
    "on_hand",
    "available",
    "threshold"
  ],
  "additionalProperties": false
}
