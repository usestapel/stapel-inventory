  "components": {
    "schemas": {
      "AlertStateEnum": {
        "enum": [
          "ok",
          "low",
          "out"
        ],
        "type": "string",
        "description": "* `ok` - OK\n* `low` - Low\n* `out` - Out of stock"
      },
      "AvailabilityItem": {
        "type": "object",
        "properties": {
          "purchasable_type": {
            "type": "string",
            "maxLength": 32
          },
          "purchasable_key": {
            "type": "string",
            "maxLength": 255
          },
          "state": {
            "$ref": "#/components/schemas/AvailabilityStateEnum"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "nullable": true,
            "description": "Units available; only under PUBLIC_AVAILABILITY='exact', else null."
          }
        },
        "required": [
          "purchasable_key",
          "purchasable_type",
          "quantity",
          "state"
        ]
      },
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilityItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "AvailabilityStateEnum": {
        "enum": [
          "in_stock",
          "few_left",
          "out_of_stock",
          "backorder",
          "untracked"
        ],
        "type": "string",
        "description": "* `in_stock` - in_stock\n* `few_left` - few_left\n* `out_of_stock` - out_of_stock\n* `backorder` - backorder\n* `untracked` - untracked"
      },
      "BlankEnum": {
        "enum": [
          ""
        ]
      },
      "LocationPage": {
        "type": "object",
        "description": "The anchor envelope of the locations list (schema only — the paginator builds it).",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationResponse"
            }
          },
          "next_anchor": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "prev_anchor": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "has_next": {
            "type": "boolean"
          },
          "has_prev": {
            "type": "boolean"
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "count",
          "has_next",
          "has_prev",
          "items",
          "next_anchor",
          "prev_anchor"
        ],
        "x-stapel-pagination": {
          "style": "anchor",
          "items": "items"
        }
      },
      "LocationRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[-a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "priority": {
            "type": "integer",
